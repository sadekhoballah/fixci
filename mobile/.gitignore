# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase config — environment-specific, never commit
/android/app/google-services.json
/ios/Runner/GoogleService-Info.plist

# Release signing — this is the app's permanent signing identity; losing
# it means Fix Pro can never be updated again under the same package
# identity once published. Never commit either file.
/android/key.properties
/android/*.jks
/android/*.keystore

# Generated by `flutter gen-l10n` (see l10n.yaml) on every `flutter pub
# get`/build — only the .arb sources under lib/l10n/ are tracked.
/lib/l10n/app_localizations*.dart

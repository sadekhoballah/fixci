NODE_ENV=development
PORT=3000

DATABASE_HOST=localhost
DATABASE_PORT=5434
DATABASE_USER=fixci
DATABASE_PASSWORD=fixci
DATABASE_NAME=fixci

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_TLS=

# Comma-separated list of allowed browser origins for CORS (both the HTTP
# API and the matching WebSocket gateway). Empty = permissive outside
# production, fully closed in production until set.
ALLOWED_ORIGINS=

# Only used for FCM push now (see firebase/notifications.service.ts). Phone
# verification (previously WhatsApp Cloud API OTP) has been dropped for this
# phase — see auth/reconnect.controller.ts for what's left of phone-based
# auth. Real verification (WhatsApp Business API or Twilio Verify) is coming
# back in a later phase.
FIREBASE_SERVICE_ACCOUNT_PATH=

# Signs the access/refresh JWTs issued by POST /auth/reconnect and
# POST /users/register (see auth/tokens.service.ts). Required in production —
# same generation recipe as ADMIN_JWT_SECRET below, but these must be
# different secrets from it and from each other.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Only takes effect when NODE_ENV is not "production" — lets requests
# authenticate with a plain X-Dev-Phone header instead of a real access
# token, for local dev/manual testing. The mobile app itself never sends
# this header; it's for curl/Postman-style testing only. Never enable in
# production.
ALLOW_DEV_AUTH_BYPASS=

# Shared secret the Wave webhook call must present via X-Webhook-Secret.
# Required in production; if unset in dev, the webhook is accepted
# unauthenticated (with a warning) so local testing doesn't need one.
WAVE_WEBHOOK_SECRET=

# Same idea as WAVE_WEBHOOK_SECRET above, for Lebanon's Whish webhook.
WHISH_WEBHOOK_SECRET=

# Signs JWTs issued by POST /admin-auth/login for the admin dashboard.
# Required in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_JWT_SECRET=

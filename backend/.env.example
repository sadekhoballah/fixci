NODE_ENV=development
PORT=3000

DATABASE_HOST=localhost
DATABASE_PORT=5434
DATABASE_USER=fixci
DATABASE_PASSWORD=fixci
DATABASE_NAME=fixci

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_TLS=

# Comma-separated list of allowed browser origins for CORS (both the HTTP
# API and the matching WebSocket gateway). Empty = permissive outside
# production, fully closed in production until set.
ALLOWED_ORIGINS=

# Only used for FCM push now (see firebase/notifications.service.ts).
FIREBASE_SERVICE_ACCOUNT_PATH=

# Google Cloud Vision API key — the content check on ID-card / license
# uploads (uploads/id-document-check.ts). One images:annotate call per upload
# (TEXT + LABEL + FACE) scores the photo against the words on a real
# CNI/passeport/permis; a "no document at all" result is refused at upload
# time with an actionable message, everything else goes to the manual review
# queue. Unset => the check is skipped (fail-open): every upload passes
# straight to manual review. Restrict the key to the Vision API in the Google
# Cloud console. Roughly: first 1000 uploads/month free, then ~1.50 USD per
# 1000 per feature.
GOOGLE_VISION_API_KEY=

# Twilio Verify — phone OTP for first-time registration (see
# auth/twilio-verify.service.ts). Verify owns code generation, the code TTL
# (set on the Service in Twilio's console — target 5 min), the SMS/WhatsApp
# template, and its own fraud rate-limits; the extra abuse ladder is in
# auth/otp-throttle.service.ts. Not configured outside production => dev
# bypass accepts the fixed code 000000.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# WhatsApp is the primary channel, SMS the manual fallback. Set to "false"
# to force SMS-only — e.g. before a Twilio WhatsApp sender is linked to the
# Verify Service.
TWILIO_VERIFY_WHATSAPP_ENABLED=true

# Pilot test phones: comma-separated E.164 numbers (exactly as the app sends
# them, e.g. +9613111111,+22507070707) that bypass Twilio entirely — no SMS
# is sent and they verify with OTP_TEST_CODE. Safe to keep set in production
# during the pilot: only these exact numbers skip the paid SMS. Leave empty
# to disable. Nothing to configure on the Twilio side.
OTP_TEST_PHONES=
OTP_TEST_CODE=000000

# Signs the access/refresh JWTs issued by POST /auth/otp/check and
# POST /users/register (see auth/tokens.service.ts). Required in production —
# same generation recipe as ADMIN_JWT_SECRET below, but these must be
# different secrets from it and from each other. The registration token
# (POST /auth/otp/check -> POST /users/register) is signed with a key
# derived from JWT_ACCESS_SECRET, so it needs no separate variable.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Only takes effect when NODE_ENV is not "production" — lets requests
# authenticate with a plain X-Dev-Phone header instead of a real access
# token, for local dev/manual testing. The mobile app itself never sends
# this header; it's for curl/Postman-style testing only. Never enable in
# production.
ALLOW_DEV_AUTH_BYPASS=

# Shared secret the Wave webhook call must present via X-Webhook-Secret.
# Required in production; if unset in dev, the webhook is accepted
# unauthenticated (with a warning) so local testing doesn't need one.
WAVE_WEBHOOK_SECRET=

# Same idea as WAVE_WEBHOOK_SECRET above, for Lebanon's Whish webhook.
WHISH_WEBHOOK_SECRET=

# Signs JWTs issued by POST /admin-auth/login for the admin dashboard.
# Required in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_JWT_SECRET=

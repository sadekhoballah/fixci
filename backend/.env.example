NODE_ENV=development
PORT=3000

DATABASE_HOST=localhost
DATABASE_PORT=5434
DATABASE_USER=fixci
DATABASE_PASSWORD=fixci
DATABASE_NAME=fixci

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_TLS=

# Comma-separated list of allowed browser origins for CORS (both the HTTP
# API and the matching WebSocket gateway). Empty = permissive outside
# production, fully closed in production until set.
ALLOWED_ORIGINS=

# Only used for FCM push now (see firebase/notifications.service.ts) — phone
# verification moved to WhatsApp Cloud API below.
FIREBASE_SERVICE_ACCOUNT_PATH=

# WhatsApp Cloud API (Meta) — sends the OTP template message from
# POST /auth/send-otp. WHATSAPP_OTP_TEMPLATE_NAME must be a template already
# approved in Meta Business Manager (free-form text can't be sent outside a
# 24h customer session window). See whatsapp/whatsapp.service.ts.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v18.0
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANG=en_US
# "Authentication" category templates come with a "Copy code" button by
# default, which the send call has to fill in as its own component. Set to
# "false" only if your approved template doesn't have that button.
WHATSAPP_OTP_TEMPLATE_HAS_BUTTON=true

# How long a generated OTP stays valid in Redis, in seconds.
OTP_TTL_SECONDS=300

# Signs the access/refresh/registration JWTs issued by POST /auth/verify-otp
# and POST /users/register (see auth/tokens.service.ts). Required in
# production — same generation recipe as ADMIN_JWT_SECRET below, but these
# must be different secrets from it and from each other.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Only takes effect when WhatsApp Cloud API is unconfigured AND NODE_ENV is
# not "production" — lets requests authenticate with a plain X-Dev-Phone
# header instead of a real access token, for local dev/manual testing
# without WhatsApp credentials. The mobile app itself never sends this
# header; it's for curl/Postman-style testing only. Never enable in
# production.
ALLOW_DEV_AUTH_BYPASS=

# Shared secret the Wave webhook call must present via X-Webhook-Secret.
# Required in production; if unset in dev, the webhook is accepted
# unauthenticated (with a warning) so local testing doesn't need one.
WAVE_WEBHOOK_SECRET=

# Same idea as WAVE_WEBHOOK_SECRET above, for Lebanon's Whish webhook.
WHISH_WEBHOOK_SECRET=

# Signs JWTs issued by POST /admin-auth/login for the admin dashboard.
# Required in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_JWT_SECRET=

NODE_ENV=development
PORT=3000

DATABASE_HOST=localhost
DATABASE_PORT=5434
DATABASE_USER=fixci
DATABASE_PASSWORD=fixci
DATABASE_NAME=fixci

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_TLS=

# Comma-separated list of allowed browser origins for CORS (both the HTTP
# API and the matching WebSocket gateway). Empty = permissive outside
# production, fully closed in production until set.
ALLOWED_ORIGINS=

FIREBASE_SERVICE_ACCOUNT_PATH=

# Only takes effect when FIREBASE_SERVICE_ACCOUNT_PATH is unset/invalid AND
# NODE_ENV is not "production" — lets requests authenticate with a plain
# X-Dev-Phone header instead of a real Firebase ID token, for local dev
# without Firebase credentials. Never enable in production.
ALLOW_DEV_AUTH_BYPASS=

# Shared secret the Wave webhook call must present via X-Webhook-Secret.
# Required in production; if unset in dev, the webhook is accepted
# unauthenticated (with a warning) so local testing doesn't need one.
WAVE_WEBHOOK_SECRET=

# Signs JWTs issued by POST /admin-auth/login for the admin dashboard.
# Required in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_JWT_SECRET=

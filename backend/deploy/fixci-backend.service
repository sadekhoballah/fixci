[Unit]
Description=FixCi NestJS backend
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=samoce
WorkingDirectory=/home/samoce/fixci/backend
EnvironmentFile=/home/samoce/fixci/backend/.env
ExecStart=/home/samoce/.nvm/versions/node/v24.18.1/bin/node dist/main.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
